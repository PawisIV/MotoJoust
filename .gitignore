# Rojo build outputs (the canonical world lives in MotoJoust.rbxl, committed)
/build-check.rbxl
/build-check.rbxlx
/MotoJoust.rbxlx

# Roblox Studio lock files
/*.rbxlx.lock
/*.rbxl.lock

# Generated by tooling
sourcemap.json

# Wally-managed dependency folders: keep the folder stubs (so Rojo paths
# resolve on a fresh clone) but ignore everything `wally install` generates.
/Packages/*
!/Packages/.gitkeep
/ServerPackages/*
!/ServerPackages/.gitkeep
/DevPackages/*
!/DevPackages/.gitkeep

# Wally lockfile IS committed (reproducible installs) — do not ignore wally.lock

# Per-user local Claude Code settings (team config goes in .claude/settings.json)
/.claude/settings.local.json
